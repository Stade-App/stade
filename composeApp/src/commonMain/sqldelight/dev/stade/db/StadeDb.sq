CREATE TABLE LocalIdentity (
    id TEXT NOT NULL PRIMARY KEY,
    nickname TEXT NOT NULL,
    publicKey BLOB NOT NULL,
    privateKey BLOB NOT NULL,
    handshakePublicKey BLOB NOT NULL,
    handshakePrivateKey BLOB NOT NULL,
    mlkemPublicKey BLOB NOT NULL,
    mlkemPrivateKey BLOB NOT NULL,
    mldsaPublicKey BLOB NOT NULL,
    mldsaPrivateKey BLOB NOT NULL,
    createdAt INTEGER NOT NULL
);

CREATE TABLE Contact (
    id TEXT NOT NULL PRIMARY KEY,
    ownerId TEXT NOT NULL,
    nickname TEXT NOT NULL,
    publicKey BLOB NOT NULL,
    handshakePublicKey BLOB NOT NULL,
    mlkemPublicKey BLOB NOT NULL,
    mldsaPublicKey BLOB NOT NULL,
    rootKey BLOB NOT NULL,
    ratchetState BLOB,
    isAlice INTEGER NOT NULL DEFAULT 0,
    verified INTEGER NOT NULL DEFAULT 0,
    lastSeen INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL,
    addresses TEXT NOT NULL DEFAULT '',
    kind INTEGER NOT NULL DEFAULT 0,
    muted INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY(ownerId) REFERENCES LocalIdentity(id)
);

CREATE TABLE PendingContact (
    id TEXT NOT NULL PRIMARY KEY,
    ownerId TEXT NOT NULL,
    alias TEXT NOT NULL,
    inviteLink TEXT NOT NULL,
    state TEXT NOT NULL,
    createdAt INTEGER NOT NULL
);

CREATE TABLE Message (
    id TEXT NOT NULL PRIMARY KEY,
    contactId TEXT NOT NULL,
    direction TEXT NOT NULL,
    body TEXT NOT NULL,
    timestamp INTEGER NOT NULL,
    delivered INTEGER NOT NULL DEFAULT 0,
    read INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY(contactId) REFERENCES Contact(id)
);

CREATE INDEX idxMessageContact ON Message(contactId, timestamp);

CREATE TABLE Outbox (
    id TEXT NOT NULL PRIMARY KEY,
    contactId TEXT NOT NULL,
    messageId TEXT NOT NULL,
    payload BLOB NOT NULL,
    attempts INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL
);

CREATE INDEX idxOutboxContact ON Outbox(contactId);

CREATE TABLE TransportSetting (
    type TEXT NOT NULL PRIMARY KEY,
    enabled INTEGER NOT NULL DEFAULT 1,
    config TEXT NOT NULL DEFAULT ''
);

CREATE TABLE KeyValue (
    key TEXT NOT NULL PRIMARY KEY,
    value BLOB NOT NULL
);

CREATE TABLE ProcessedEnvelope (
    messageId TEXT NOT NULL PRIMARY KEY,
    contactId TEXT NOT NULL,
    processedAt INTEGER NOT NULL
);

CREATE INDEX idxProcessedEnvelope ON ProcessedEnvelope(processedAt);

selectAllIdentities:
SELECT * FROM LocalIdentity;

selectIdentity:
SELECT * FROM LocalIdentity WHERE id = ?;

insertIdentity:
INSERT INTO LocalIdentity(id, nickname, publicKey, privateKey, handshakePublicKey, handshakePrivateKey, mlkemPublicKey, mlkemPrivateKey, mldsaPublicKey, mldsaPrivateKey, createdAt) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectContacts:
SELECT * FROM Contact WHERE ownerId = ? ORDER BY nickname;

selectAllContacts:
SELECT * FROM Contact;

selectContact:
SELECT * FROM Contact WHERE id = ?;

selectContactByPublicKey:
SELECT * FROM Contact WHERE publicKey = ?;

selectContactByStadeId:
SELECT * FROM Contact WHERE id = ?;

insertContact:
INSERT INTO Contact(id, ownerId, nickname, publicKey, handshakePublicKey, mlkemPublicKey, mldsaPublicKey, rootKey, ratchetState, isAlice, verified, lastSeen, createdAt, addresses, kind) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

setContactVerified:
UPDATE Contact SET verified = 1 WHERE id = ?;

setContactRatchet:
UPDATE Contact SET ratchetState = ? WHERE id = ?;

setContactSeen:
UPDATE Contact SET lastSeen = ? WHERE id = ?;

setContactAddresses:
UPDATE Contact SET addresses = ? WHERE id = ?;

renameContact:
UPDATE Contact SET nickname = ? WHERE id = ?;

setContactKind:
UPDATE Contact SET kind = ? WHERE id = ?;

setContactMuted:
UPDATE Contact SET muted = ? WHERE id = ?;

deleteContact:
DELETE FROM Contact WHERE id = ?;

deleteMessagesForContact:
DELETE FROM Message WHERE contactId = ?;

deleteOutboxForContact:
DELETE FROM Outbox WHERE contactId = ?;

insertPending:
INSERT INTO PendingContact(id, ownerId, alias, inviteLink, state, createdAt) VALUES (?, ?, ?, ?, ?, ?);

selectPending:
SELECT * FROM PendingContact WHERE ownerId = ?;

deletePending:
DELETE FROM PendingContact WHERE id = ?;

insertMessage:
INSERT INTO Message(id, contactId, direction, body, timestamp, delivered, read) VALUES (?, ?, ?, ?, ?, ?, ?);

selectMessages:
SELECT * FROM Message WHERE contactId = ? ORDER BY timestamp ASC;

selectLastMessage:
SELECT * FROM Message WHERE contactId = ? ORDER BY timestamp DESC LIMIT 1;

selectLastMessagePreview:
SELECT id, contactId, direction, substr(body, 1, 200) AS body, timestamp, delivered, read FROM Message WHERE contactId = ? ORDER BY timestamp DESC LIMIT 1;

markDelivered:
UPDATE Message SET delivered = 1 WHERE id = ?;

markRead:
UPDATE Message SET read = 1 WHERE contactId = ?;

countUnread:
SELECT COUNT(*) FROM Message WHERE contactId = ? AND read = 0 AND direction = 'IN';

countAllUnread:
SELECT COUNT(*) FROM Message WHERE read = 0 AND direction = 'IN';

messageExists:
SELECT COUNT(*) FROM Message WHERE id = ?;

enqueueOutbox:
INSERT INTO Outbox(id, contactId, messageId, payload, attempts, createdAt) VALUES (?, ?, ?, ?, ?, ?);

selectOutbox:
SELECT * FROM Outbox WHERE contactId = ? ORDER BY createdAt ASC;

selectAllOutbox:
SELECT * FROM Outbox ORDER BY createdAt ASC;

bumpOutbox:
UPDATE Outbox SET attempts = attempts + 1 WHERE id = ?;

deleteOutbox:
DELETE FROM Outbox WHERE id = ?;

deleteOutboxForMessage:
DELETE FROM Outbox WHERE messageId = ?;

deleteOutboxForContactMessage:
DELETE FROM Outbox WHERE messageId = ? AND contactId = ?;

deleteMessageById:
DELETE FROM Message WHERE id = ?;

deleteGroupMessageById:
DELETE FROM GroupMessage WHERE id = ?;

upsertTransport:
INSERT OR REPLACE INTO TransportSetting(type, enabled, config) VALUES (?, ?, ?);

selectTransports:
SELECT * FROM TransportSetting;

selectTransport:
SELECT * FROM TransportSetting WHERE type = ?;

putKv:
INSERT OR REPLACE INTO KeyValue(key, value) VALUES (?, ?);

getKv:
SELECT value FROM KeyValue WHERE key = ?;

deleteKv:
DELETE FROM KeyValue WHERE key = ?;

selectKvPrefixed:
SELECT key, value FROM KeyValue WHERE key LIKE ? ORDER BY key;

envelopeProcessed:
SELECT COUNT(*) FROM ProcessedEnvelope WHERE messageId = ?;

markEnvelopeProcessed:
INSERT OR IGNORE INTO ProcessedEnvelope(messageId, contactId, processedAt) VALUES (?, ?, ?);

pruneProcessedEnvelope:
DELETE FROM ProcessedEnvelope WHERE processedAt < ?;

wipeMessages:
DELETE FROM Message;

wipeOutbox:
DELETE FROM Outbox;

wipeContacts:
DELETE FROM Contact;

wipePending:
DELETE FROM PendingContact;

wipeIdentities:
DELETE FROM LocalIdentity;

wipeTransports:
DELETE FROM TransportSetting;

wipeKeyValue:
DELETE FROM KeyValue;

wipeProcessedEnvelope:
DELETE FROM ProcessedEnvelope;

CREATE TABLE StadeGroup (
    id TEXT NOT NULL PRIMARY KEY,
    ownerId TEXT NOT NULL,
    name TEXT NOT NULL,
    inviteToken TEXT NOT NULL,
    createdAt INTEGER NOT NULL,
    creatorStadeId TEXT NOT NULL DEFAULT '',
    muted INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE GroupMember (
    groupId TEXT NOT NULL,
    contactId TEXT NOT NULL,
    joinedAt INTEGER NOT NULL,
    PRIMARY KEY(groupId, contactId)
);

CREATE TABLE GroupMessage (
    id TEXT NOT NULL PRIMARY KEY,
    groupId TEXT NOT NULL,
    senderId TEXT NOT NULL,
    body TEXT NOT NULL,
    timestamp INTEGER NOT NULL,
    outgoing INTEGER NOT NULL DEFAULT 0,
    read INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX idxGroupMessage ON GroupMessage(groupId, timestamp);

insertGroup:
INSERT INTO StadeGroup(id, ownerId, name, inviteToken, createdAt, creatorStadeId) VALUES (?, ?, ?, ?, ?, ?);

selectGroups:
SELECT * FROM StadeGroup WHERE ownerId = ? ORDER BY name;

selectGroup:
SELECT * FROM StadeGroup WHERE id = ?;

selectGroupByToken:
SELECT * FROM StadeGroup WHERE inviteToken = ?;

deleteGroup:
DELETE FROM StadeGroup WHERE id = ?;

setGroupMuted:
UPDATE StadeGroup SET muted = ? WHERE id = ?;

insertGroupMember:
INSERT OR IGNORE INTO GroupMember(groupId, contactId, joinedAt) VALUES (?, ?, ?);

selectGroupMembers:
SELECT * FROM GroupMember WHERE groupId = ?;

memberGroupIds:
SELECT groupId FROM GroupMember WHERE contactId = ?;

deleteGroupMember:
DELETE FROM GroupMember WHERE groupId = ? AND contactId = ?;

deleteGroupMembers:
DELETE FROM GroupMember WHERE groupId = ?;

insertGroupMessage:
INSERT INTO GroupMessage(id, groupId, senderId, body, timestamp, outgoing, read) VALUES (?, ?, ?, ?, ?, ?, ?);

selectGroupMessages:
SELECT * FROM GroupMessage WHERE groupId = ? ORDER BY timestamp ASC;

selectLastGroupMessage:
SELECT * FROM GroupMessage WHERE groupId = ? ORDER BY timestamp DESC LIMIT 1;

selectLastGroupMessagePreview:
SELECT id, groupId, senderId, substr(body, 1, 200) AS body, timestamp, outgoing, read FROM GroupMessage WHERE groupId = ? ORDER BY timestamp DESC LIMIT 1;

countGroupUnread:
SELECT COUNT(*) FROM GroupMessage WHERE groupId = ? AND read = 0 AND outgoing = 0;

markGroupRead:
UPDATE GroupMessage SET read = 1 WHERE groupId = ?;

groupMessageExists:
SELECT COUNT(*) FROM GroupMessage WHERE id = ?;

isGroupMember:
SELECT COUNT(*) FROM GroupMember WHERE groupId = ? AND contactId = ?;

selectAllGroupMembersForOwner:
SELECT gm.groupId, gm.contactId FROM GroupMember gm
JOIN StadeGroup g ON g.id = gm.groupId
WHERE g.ownerId = ?;

deleteGroupMessages:
DELETE FROM GroupMessage WHERE groupId = ?;

wipeGroups:
DELETE FROM StadeGroup;

wipeGroupMembers:
DELETE FROM GroupMember;

wipeGroupMessages:
DELETE FROM GroupMessage;

CREATE TABLE MessageReaction (
    messageId TEXT NOT NULL,
    fromId TEXT NOT NULL,
    emoji TEXT NOT NULL,
    PRIMARY KEY(messageId, fromId)
);

CREATE INDEX idxMessageReaction ON MessageReaction(messageId);

upsertReaction:
INSERT OR REPLACE INTO MessageReaction(messageId, fromId, emoji) VALUES (?, ?, ?);

deleteReaction:
DELETE FROM MessageReaction WHERE messageId = ? AND fromId = ?;

selectReactionsForMessage:
SELECT * FROM MessageReaction WHERE messageId = ?;

deleteReactionsForMessage:
DELETE FROM MessageReaction WHERE messageId = ?;

wipeReactions:
DELETE FROM MessageReaction;

searchMessages:
SELECT Message.*, Contact.nickname AS contactNickname FROM Message
JOIN Contact ON Contact.id = Message.contactId
WHERE Message.contactId IN (SELECT id FROM Contact WHERE ownerId = :ownerId)
AND Message.body LIKE '%' || :query || '%'
AND Message.body NOT LIKE 'STADE_IMG_V1:%' AND Message.body NOT LIKE 'STADE_VOI_V1:%'
ORDER BY Message.timestamp DESC LIMIT :resultLimit;

searchGroupMessages:
SELECT GroupMessage.*, StadeGroup.name AS groupName FROM GroupMessage
JOIN StadeGroup ON StadeGroup.id = GroupMessage.groupId
WHERE StadeGroup.ownerId = :ownerId
AND GroupMessage.body LIKE '%' || :query || '%'
AND GroupMessage.body NOT LIKE 'STADE_IMG_V1:%' AND GroupMessage.body NOT LIKE 'STADE_VOI_V1:%'
ORDER BY GroupMessage.timestamp DESC LIMIT :resultLimit;

CREATE TABLE Stadium (
    id TEXT NOT NULL PRIMARY KEY,
    ownerId TEXT NOT NULL,
    name TEXT NOT NULL,
    creatorStadeId TEXT NOT NULL,
    isOwner INTEGER NOT NULL DEFAULT 0,
    inviteToken TEXT NOT NULL,
    memberCount INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL,
    muted INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE StadiumMember (
    stadiumId TEXT NOT NULL,
    contactId TEXT NOT NULL,
    joinedAt INTEGER NOT NULL,
    PRIMARY KEY(stadiumId, contactId)
);

CREATE TABLE StadiumMessage (
    id TEXT NOT NULL PRIMARY KEY,
    stadiumId TEXT NOT NULL,
    body TEXT NOT NULL,
    timestamp INTEGER NOT NULL,
    outgoing INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX idxStadiumMessage ON StadiumMessage(stadiumId, timestamp);

insertStadium:
INSERT INTO Stadium(id, ownerId, name, creatorStadeId, isOwner, inviteToken, memberCount, createdAt) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectStadiums:
SELECT * FROM Stadium WHERE ownerId = ? ORDER BY name;

selectStadium:
SELECT * FROM Stadium WHERE id = ?;

deleteStadium:
DELETE FROM Stadium WHERE id = ?;

renameStadium:
UPDATE Stadium SET name = ? WHERE id = ?;

setStadiumMemberCount:
UPDATE Stadium SET memberCount = ? WHERE id = ?;

setStadiumMuted:
UPDATE Stadium SET muted = ? WHERE id = ?;

insertStadiumMember:
INSERT OR IGNORE INTO StadiumMember(stadiumId, contactId, joinedAt) VALUES (?, ?, ?);

selectStadiumMembers:
SELECT * FROM StadiumMember WHERE stadiumId = ?;

countStadiumMembers:
SELECT COUNT(*) FROM StadiumMember WHERE stadiumId = ?;

deleteStadiumMembers:
DELETE FROM StadiumMember WHERE stadiumId = ?;

deleteStadiumMember:
DELETE FROM StadiumMember WHERE stadiumId = ? AND contactId = ?;

memberStadiumIds:
SELECT stadiumId FROM StadiumMember WHERE contactId = ?;

insertStadiumMessage:
INSERT INTO StadiumMessage(id, stadiumId, body, timestamp, outgoing) VALUES (?, ?, ?, ?, ?);

selectStadiumMessages:
SELECT * FROM StadiumMessage WHERE stadiumId = ? ORDER BY timestamp ASC;

selectLastStadiumMessage:
SELECT * FROM StadiumMessage WHERE stadiumId = ? ORDER BY timestamp DESC LIMIT 1;

stadiumMessageExists:
SELECT COUNT(*) FROM StadiumMessage WHERE id = ?;

deleteStadiumMessages:
DELETE FROM StadiumMessage WHERE stadiumId = ?;

deleteStadiumMessage:
DELETE FROM StadiumMessage WHERE id = ?;

wipeStadiums:
DELETE FROM Stadium;

wipeStadiumMembers:
DELETE FROM StadiumMember;

wipeStadiumMessages:
DELETE FROM StadiumMessage;

searchStadiumMessages:
SELECT StadiumMessage.*, Stadium.name AS stadiumName FROM StadiumMessage
JOIN Stadium ON Stadium.id = StadiumMessage.stadiumId
WHERE Stadium.ownerId = :ownerId
AND StadiumMessage.body LIKE '%' || :query || '%'
AND StadiumMessage.body NOT LIKE 'STADE_IMG_V1:%' AND StadiumMessage.body NOT LIKE 'STADE_VOI_V1:%'
ORDER BY StadiumMessage.timestamp DESC LIMIT :resultLimit;

